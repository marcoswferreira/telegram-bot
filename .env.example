# Required: Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Optional: Default target group/channel ID (e.g. -1001234567890 or @channelusername)
# Can be omitted if every API request provides chat_id in its JSON payload
TELEGRAM_CHAT_ID=-1001234567890

# Optional: API key for authenticating POST /api/v1/messages
# Accepts either `X-API-Key: <key>` or `Authorization: Bearer <key>`
# Leave empty/unset to disable authentication (internal/private networks only)
API_KEY=change-me-to-a-strong-secret

# Optional: HTTP bind address (default: 0.0.0.0:8080)
LISTEN_ADDR=0.0.0.0:8080

# Optional: Log filter (default: info)
RUST_LOG=info

# Optional: MTProto credentials from https://my.telegram.org (required only for creating channels/groups)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=./data/telegram.session
